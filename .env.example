# Copy to .env.local to override per environment. Only VITE_* vars reach the client.
#
# These Firebase values are PUBLIC by design (a Firebase web config is not a
# secret — Firestore security rules protect the data). They match the "PAAIPE web"
# app in the shared project "PAAIPE and POSTFLOW" (id postflowit-autos) and are
# also compiled in as defaults in src/lib/firebase.ts, so the app works without
# this file. Override here only to point at a different Firebase project.
VITE_FIREBASE_API_KEY=AIzaSyCeZ6CcSV79l9TPNK6UL0SV5d5b8EU11n8
VITE_FIREBASE_AUTH_DOMAIN=postflowit-autos.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=postflowit-autos
VITE_FIREBASE_STORAGE_BUCKET=postflowit-autos.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=558511325456
VITE_FIREBASE_APP_ID=1:558511325456:web:6f8f383eb10116db8c6595
VITE_API_BASE=https://api.paaipe.org
VITE_MEDIA_BASE=https://media.paaipe.org
# Optional. Full URL of the `eventRegistrationCounts` Cloud Function. When set,
# the Events screen shows real per-event registered totals (aggregate only — the
# endpoint never returns registrant rows). Leave blank to hide the numbers.
VITE_PAAIPE_COUNTS_URL=
# Optional. Full URL of the telemetry-ingest Cloud Function. When set, the app
# posts anonymous offline-write counters so the fleet-wide offline rate is
# visible server-side. Leave blank to keep telemetry on-device only.
VITE_PAAIPE_TELEMETRY_URL=
# Optional. Firestore database id. Defaults to "paaipe"; the emulator-backed
# integration test overrides this to "(default)".
VITE_FIRESTORE_DATABASE_ID=paaipe
