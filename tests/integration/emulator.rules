rules_version = '2';
// Permissive rules for the OFFLINE-QUEUE integration test only. This test
// verifies flushRegistrationQueue plumbs writes through to Firestore and stays
// idempotent — NOT the production access rules (those are covered by the backend
// emulator suite, tests/emulator/registration_rules.mjs in the portal repo).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
